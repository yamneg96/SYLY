{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix web ci",
  "buildCommand": "npm --prefix web run build && node scripts/assemble-static.mjs --target vercel",
  "outputDirectory": "web/dist",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://syly-api.onrender.com/api/:path*" },
    { "source": "/sms/:path*", "destination": "https://syly-api.onrender.com/sms/:path*" },
    { "source": "/docs", "destination": "https://syly-api.onrender.com/docs" },
    { "source": "/openapi.json", "destination": "https://syly-api.onrender.com/openapi.json" },
    { "source": "/starter", "destination": "/starter.html" },
    { "source": "/((?!api/|sms/|docs$|openapi\\.json$|module/|demo/|pages/|assets/|patch/|portal-assets/|data/|starter\\.html|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/module/(.*)", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/demo/(.*)", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/portal-assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
