# Copy to .env. Every value is optional: with nothing set, the module answers by
# keyword search only (PROVIDER=none behaviour) and the bot does not start.

# AI provider: cloud = Gemini, then Groq on error or timeout, then none
#              local = Ollama at OLLAMA_URL, then none
#              none  = keyword search only
PROVIDER=cloud
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b

# Seconds to wait for one AI provider before trying the next.
PROVIDER_TIMEOUT=8

# Speech to text: seconds per engine (Addis AI, Gemini audio, Groq Whisper).
STT_TIMEOUT=15
# Optional local Meta MMS for Tigrinya: CC-BY-NC 4.0 (non-commercial), about 1B parameters, slow on CPU.
# Needs `pip install transformers torch` in the api image. Off by default.
MMS_ENABLED=false

# Telegram bot (BotFather). BOT_TOKEN is also accepted. Username is optional (else asked from Telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Only if this network blocks api.telegram.org, e.g. socks5://127.0.0.1:1080 or http://proxy:3128
TELEGRAM_PROXY=
# Public address of the pages, used in links the bot sends (your cloudflared HTTPS address).
PUBLIC_BASE_URL=http://localhost:8080

# Optional Addis AI (docs.addisassistant.com): Amharic TTS fallback and STT. Needs account credit.
ADDIS_AI_API_KEY=
# Addis AI voice for Amharic (GET /api/v1/voice/voices?language=am lists them). Paid per minute.
ADDIS_TTS_VOICE=am-hamen

# Pages allowed to call the API (comma separated). Default allows the demo on :8080.
HOST_ORIGINS=http://localhost:8080

# Encrypts stored contacts. If empty, a key is generated once and kept in data/.fernet_key.
FERNET_KEY=

# Helper page and helper-only endpoints. Empty = open (demo only). Set a long random value in production.
HELPER_KEY=
